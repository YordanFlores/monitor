# Opcional: forzar URL del broker. Si no se define:
# - HTTPS y hostname *omnitec.store* → wss://<host>/ws
# - resto (casa/LAN) → ws://192.168.100.40:9001
# NEXT_PUBLIC_MQTT_WS_URL=wss://monitor.omnitec.store/ws

# Si el broker usa una ruta extra (p. ej. /mqtt) y la base no la incluye:
# NEXT_PUBLIC_MQTT_WS_PATH=/mqtt

# Origen solo para GET /api/config (si difiere del ESP). Si no se define, se usa OMNITEC_ESP_ORIGIN.
# NEXT_PUBLIC_OMNITEC_CONFIG_ORIGIN=http://192.168.4.1

# Origen HTTP del ESP32 (sin barra final): GET /api/config, OTA /update, /api/logs…
# Si no se define, la web usa por defecto http://192.168.4.1 (AP típico del ESP).
# NEXT_PUBLIC_OMNITEC_ESP_ORIGIN=http://192.168.100.50

# Obsoleto si solo usas MQTT: WebSocket directo al ESP (puerto 81). Reservado por compatibilidad en lib/esp-api.
# NEXT_PUBLIC_OMNITEC_ESP_WS=ws://192.168.4.1:81/

# Unidades listadas en el dashboard (coma)
NEXT_PUBLIC_SCADA_UNITS=UNIDAD_01,UNIDAD_02

# Servidor (misma máquina que Next + ingest): directorio de un archivo .log por unidad (caja negra persistente)
# CAJA_NEGRA_DIR=/var/lib/omnitec/caja-negra

# Solo para scripts/mqtt-log-ingest.cjs en el servidor (broker local, p. ej. Mosquitto en 192.168.100.40)
# MQTT_URL=mqtt://127.0.0.1:1883

# Solo dev: saltar overlay de PIN inicial (ACCESO OMNITEC)
# NEXT_PUBLIC_OMNITEC_SKIP_LOGIN=1

# PIN de 4 dígitos que acepta la web sin llamar al ESP (mismo que el PLC)
# NEXT_PUBLIC_OMNITEC_LOGIN_PIN=1234
